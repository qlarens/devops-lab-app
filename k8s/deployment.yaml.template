apiVersion: apps/v1
kind: Deployment
metadata:
  name: app
  namespace: devops-lab
spec:
  replicas: 3
  selector:
    matchLabels:
      app: app
  template:
    metadata:
      labels:
        app: app
    spec:
      imagePullSecrets:
        - name: ghcr-auth
      containers:
        - name: webapp-container
          image: ${FULL_IMAGE}
          ports:
            - containerPort: 8000