apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: lab-app-ingress
  namespace: devops-lab
  annotations:
    nginx.ingress.kubernetes.io/rewrite-target: /
spec:
  ingressClassName: nginx
  rules:
  - host: app.${NODE_IP}.nip.io
    http:
      paths:
        - path: /
          pathType: Prefix
          backend:
            service:
              name: lab-app-service
              port:
                number: 80